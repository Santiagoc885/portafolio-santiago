---
/**
 * Roles del posicionamiento: una línea de 3 roles que se alterna automáticamente con los siguientes 3.
 * - Solo CSS. Todos los grupos comparten las mismas 3 columnas, así las posiciones no saltan.
 * - Lectores de pantalla: leen la lista completa; la animación es aria-hidden.
 * - prefers-reduced-motion: sigue alternando, pero solo con fundido (sin desplazamiento).
 */
interface Props {
  roles: string[];
  axisByRole?: Record<string, string>;
  label: string;
  /** Roles por línea. */
  perLine?: number;
  /** Segundos que cada grupo permanece visible. */
  step?: number;
}
const { roles, axisByRole = {}, label, perLine = 3, step = 3 } = Astro.props;

const groups: string[][] = [];
for (let i = 0; i < roles.length; i += perLine) groups.push(roles.slice(i, i + perLine));
const total = groups.length * step;

// Ciclo por grupo: visible → sale hacia arriba → espera → entra desde abajo.
const fadeOut = 0.45;
const pct = (s: number) => ((s / total) * 100).toFixed(2);
const keyframes =
  `@keyframes roles-slide{0%,${pct(step - fadeOut)}%{opacity:1;transform:none}${pct(step)}%{opacity:0;transform:translateY(-0.6em)}${pct(total - fadeOut)}%{opacity:0;transform:translateY(0.6em)}100%{opacity:1;transform:none}}` +
  `@keyframes roles-fade{0%,${pct(step - fadeOut)}%{opacity:1}${pct(step)}%,${pct(total - fadeOut)}%{opacity:0}100%{opacity:1}}`;
---

<div class="roles" style={`--total:${total}s;--cols:${perLine}`}>
  <p class="sr-only">{label}: {roles.join(', ')}.</p>
  <ul class="line" aria-hidden="true">
    {
      groups.flatMap((g, gi) =>
        g.map((r, ci) => (
          <li
            class={axisByRole[r] ? `axis-${axisByRole[r]}` : undefined}
            style={`grid-column:${ci + 1};--delay:${(gi === 0 ? 0 : gi * step - total) + ci * 0.08}s`}
          >
            {r}
          </li>
        )),
      )
    }
  </ul>
</div>

<style is:inline set:html={keyframes}></style>

<style>
  .line {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, max-content));
    gap: 0 1.25rem;
    margin: 0;
    padding: 0.15em 0;
    list-style: none;
    overflow: hidden;
  }
  li {
    grid-row: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 620;
    line-height: 1.3;
    color: var(--axis, var(--text));
    opacity: 0;
    animation: roles-slide var(--total) cubic-bezier(0.4, 0, 0.2, 1) var(--delay) infinite both;
  }
  li::before {
    content: '';
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--axis, var(--text));
    translate: 0 -0.1em;
  }
  @media (min-width: 48rem) {
    .line {
      column-gap: 3cm;
    }
    li {
      white-space: nowrap;
    }
  }
  @media (max-width: 30rem) {
    li {
      font-size: 0.875rem;
      gap: 0.375rem;
    }
  }

  /* Movimiento reducido: sin desplazamiento, solo fundido. Anula la regla global que corta animaciones. */
  @media (prefers-reduced-motion: reduce) {
    .line li {
      animation-name: roles-fade !important;
      animation-duration: var(--total) !important;
      animation-iteration-count: infinite !important;
    }
  }
</style>
