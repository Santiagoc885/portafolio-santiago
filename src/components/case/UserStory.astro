---
/** Historia de usuario con criterios de aceptación. Usa <details>, sin JavaScript. */
import Pending from '../Pending.astro';
import { getLang, useT } from '../../i18n';

interface Criterion {
  given: string;
  when: string;
  then: string;
}
interface Props {
  as: string;
  want: string;
  so?: string;
  criteria?: Criterion[];
}
const { as, want, so, criteria = [] } = Astro.props;
const t = useT(getLang(Astro.currentLocale));
---

<details class="story">
  <summary>
    <span class="label">{t.userStory}</span>
    <span class="story-text">
      <span><b>{t.story.as}</b> {as}</span>
      <span><b>{t.story.want}</b> {want}</span>
      <span><b>{t.story.so}</b> {so ?? <Pending what={t.storyBenefit} />}</span>
    </span>
  </summary>
  {
    criteria.length > 0 && (
      <div class="criteria">
        <p class="label">{t.acceptance}</p>
        <ul>
          {criteria.map((c) => (
            <li>
              <span><b>{t.story.given}</b> {c.given}</span>
              <span><b>{t.story.when}</b> {c.when}</span>
              <span><b>{t.story.then}</b> {c.then}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</details>

<style>
  .story {
    margin-block: var(--space-4);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }
  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    grid-column: 2;
    grid-row: 1;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1;
  }
  .story[open] summary::after {
    content: '−';
  }
  .story[open] summary {
    border-bottom: 1px solid var(--line);
  }
  .story-text {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.125rem;
    max-width: var(--measure);
  }
  b {
    font-weight: 680;
  }
  .criteria {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    gap: 0.125rem;
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
  }
</style>
