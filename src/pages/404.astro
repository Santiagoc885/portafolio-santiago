---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Esta ruta no existe. / This page does not exist.">
  <section class="nf wrap" aria-labelledby="nf-title">
    <svg class="nf-mark" viewBox="0 0 120 80" aria-hidden="true" focusable="false">
      <path d="M0 40H44M76 40H120M60 0V24M60 56V80" />
      <rect x="44" y="24" width="32" height="32" />
    </svg>
    <p class="label">Error 404</p>
    <h1 id="nf-title">Este espacio no existe en el plano.</h1>
    <p class="muted">La dirección puede haber cambiado o tener un error de escritura.</p>
    <p><a class="button" href="/">Volver al inicio</a></p>
    <div class="nf-en" lang="en">
      <p class="nf-en-title">This space does not exist on the map.</p>
      <p><a href="/en">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-block: var(--space-7);
  }
  h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 6vw, 4rem);
  }
  .nf-en {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-1);
  }
  .nf-en-title {
    font-weight: 620;
  }
  .nf-mark {
    width: 7.5rem;
    margin-bottom: var(--space-3);
  }
  .nf-mark path {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    fill: none;
  }
  .nf-mark rect {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
</style>
